<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/output.css" />
</head>
<body class="min-h-screen text-slate-800 relative pb-12">

  <!-- Background Ornaments -->
  <svg class="floating-star select-none" style="top: 15%; left: 8%; fill: #facc15;" width="32" height="32" viewBox="0 0 24 24">
    <path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.784 1.4 8.168L12 18.896l-7.334 3.857 1.4-8.168L.133 9.21l8.2-1.192z"/>
  </svg>
  <svg class="floating-star select-none" style="top: 35%; right: 6%; fill: #ec4899;" width="28" height="28" viewBox="0 0 24 24">
    <path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.784 1.4 8.168L12 18.896l-7.334 3.857 1.4-8.168L.133 9.21l8.2-1.192z"/>
  </svg>

  <%- include('../../partials/header') %>

  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 fade-in-page">
    
    <!-- Back Button -->
    <div class="mb-6">
      <a href="/stories" class="btn-bubbly btn-bubbly-yellow px-5 py-2 text-sm shadow-[0_4px_0_#1e293b] flex items-center gap-1.5 w-fit">
        <span>⬅️</span> कहानियों पर वापस जाएं
      </a>
    </div>

    <section class="bubbly-card bg-white p-6 sm:p-10 shadow-[0_8px_0_#1e293b]">
      
      <div class="flex items-center justify-between mb-6 pb-4 border-b-2 border-dashed border-slate-200">
        <div>
          <h1 class="text-3xl font-extrabold text-slate-900 flex items-center gap-2">
            <span>📖</span> <%= isEdit ? 'कहानी संपादित करें' : 'नई कहानी जोड़ें' %>
          </h1>
          <p class="text-slate-500 font-semibold mt-1">
            <%= isEdit ? 'कहानी के विवरण को अपडेट करें और बदलाव सहेजें।' : 'कहानी का शीर्षक, सारांश, पूरी कहानी और ऑडियो का लिंक दर्ज करें।' %>
          </p>
        </div>
        <div class="text-4xl animate-bounce-soft select-none">✍️</div>
      </div>

      <% if (error) { %>
        <div class="mb-6 rounded-2xl border-3 border-rose-900 bg-rose-100 p-4 text-sm font-bold text-rose-800 shadow-[0_4px_0_#9f1239]">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <form method="POST" action="<%= isEdit ? `/stories/${storyId}/edit` : '/stories/new' %>" class="flex flex-col gap-6">
        
        <!-- Story Title -->
        <div>
          <label class="mb-2 flex items-center gap-1.5 text-base font-bold text-slate-800">
            <span>🏷️</span> कहानी का शीर्षक (Title) <span class="text-rose-500">*</span>
          </label>
          <input 
            type="text" 
            name="title" 
            required 
            placeholder="उदाहरण: चालाक लोमड़ी और अंगूर" 
            value="<%= formData.title || '' %>" 
            class="w-full"
          />
        </div>

        <!-- Category -->
        <div>
          <label class="mb-2 flex items-center gap-1.5 text-base font-bold text-slate-800">
            <span>🔖</span> श्रेणी (Category)
          </label>
          <select name="category" class="w-full">
            <option value="ज्ञानवर्धक" <%= formData.category === 'ज्ञानवर्धक' ? 'selected' : '' %>>ज्ञानवर्धक</option>
            <option value="शिक्षाप्रद" <%= formData.category === 'शिक्षाप्रद' ? 'selected' : '' %>>शिक्षाप्रद</option>
            <option value="लोककथा" <%= formData.category === 'लोककथा' ? 'selected' : '' %>>लोककथा</option>
            <option value="पौराणिक" <%= formData.category === 'पौराणिक' ? 'selected' : '' %>>पौराणिक</option>
            <option value="हास्य" <%= formData.category === 'हास्य' ? 'selected' : '' %>>हास्य</option>
            <option value="मजेदार" <%= formData.category === 'मजेदार' ? 'selected' : '' %>>मजेदार</option>
            <option value="सामान्य" <%= formData.category === 'सामान्य' ? 'selected' : '' %>>सामान्य</option>
          </select>
        </div>

        <!-- Summary -->
        <div>
          <label class="mb-2 flex items-center gap-1.5 text-base font-bold text-slate-800">
            <span>📝</span> संक्षिप्त सारांश (Summary) <span class="text-rose-500">*</span>
          </label>
          <textarea 
            name="summary" 
            required 
            rows="2" 
            placeholder="कहानी का छोटा सा विवरण या सार..."
            class="w-full"
          ><%= formData.summary || '' %></textarea>
        </div>

        <!-- Transcript -->
        <div>
          <label class="mb-2 flex items-center gap-1.5 text-base font-bold text-slate-800">
            <span>📖</span> पूरी कहानी (Full Transcript) <span class="text-rose-500">*</span>
          </label>
          <textarea 
            name="transcript" 
            required 
            rows="6" 
            placeholder="यहाँ पूरी कहानी लिखें..."
            class="w-full"
          ><%= formData.transcript || '' %></textarea>
        </div>

        <!-- Audio URL -->
        <div>
          <label class="mb-2 flex items-center gap-1.5 text-base font-bold text-slate-800">
            <span>🔊</span> ऑडियो का लिंक (Audio URL)
          </label>
          <input 
            type="text" 
            name="audioUrl" 
            placeholder="https://example.com/audio.mp3 (वैकल्पिक)" 
            value="<%= formData.audioUrl || '' %>" 
            class="w-full"
          />
          <p class="text-xs font-semibold text-slate-400 mt-1">यदि खाली छोड़ा तो डिफ़ॉल्ट ऑडियो का उपयोग किया जाएगा।</p>
        </div>

        <!-- Submit & Cancel Buttons -->
        <div class="flex items-center gap-4 mt-4">
          <button type="submit" class="btn-bubbly btn-bubbly-green px-8 py-3.5 text-white text-base shadow-[0_5px_0_#1e293b] flex-1 flex items-center justify-center gap-2">
            <span>💾</span> <%= isEdit ? 'परिवर्तन सहेजें' : 'कहानी सहेजें' %> 🚀
          </button>
          <a href="/stories" class="btn-bubbly btn-bubbly-orange px-6 py-3.5 text-white text-base shadow-[0_5px_0_#1e293b]">
            रद्द करें
          </a>
        </div>

      </form>

    </section>
  </main>
</body>
</html>
