<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/output.css" />
</head>
<body class="min-h-screen text-slate-800 relative pb-12">
  <%- include('../../partials/header') %>

  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8 fade-in-page">
    <section class="rounded-3xl border-3 border-slate-900 bg-white p-6 sm:p-8 shadow-[0_8px_0_#1e293b]">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h1 class="text-3xl font-black text-slate-900 flex items-center gap-2">
            <span>📊</span> स्टूडेंट गतिविधि लॉग
          </h1>
          <p class="text-slate-500 font-semibold mt-1">
            नीचे बने सर्च बॉक्स से स्टूडेंट का नाम, ईमेल, फोन या ID लिखकर गतिविधियाँ खोजें।
          </p>
        </div>
        <div class="text-4xl animate-bounce-soft select-none self-start sm:self-auto">📜</div>
      </div>

      <!-- Live Activity Search Input (Inside Activity Page) -->
      <div class="mb-6 relative">
        <div class="relative flex items-center">
          <input
            id="activity-search-input"
            type="text"
            placeholder="स्टूडेंट का नाम, फोन, ईमेल या गतिविधि खोजें..."
            class="w-full text-sm sm:text-base font-bold text-slate-800 bg-pastel-purple/50 hover:bg-pastel-purple/80 focus:bg-white placeholder-slate-400 rounded-2xl shadow-[0_4px_0_#1e293b] focus:shadow-[0_4px_0_#4f46e5] focus:outline-none transition-all duration-200"
            style="padding: 12px 45px 12px 18px !important; border-radius: 18px !important; border: 3px solid #1e293b !important;"
          />
          <span class="absolute right-4 text-xl text-slate-700 pointer-events-none select-none">
            🔍
          </span>
        </div>
      </div>

      <% if (activities.length === 0) { %>
        <div class="text-center py-12">
          <span class="text-5xl select-none inline-block">📭</span>
          <h3 class="text-xl font-bold text-slate-700 mt-4">अभी कोई स्टूडेंट गतिविधि उपलब्ध नहीं है</h3>
        </div>
      <% } else { %>
        <ul id="activity-list" class="divide-y-2 divide-slate-100 text-slate-700 font-semibold">
          <% activities.forEach((activity) => { 
            const studentName = activity.user ? activity.user.name : 'Unknown';
            const studentEmail = activity.user ? (activity.user.email || '') : '';
            const studentPhone = activity.user ? (activity.user.phone || '') : '';
            const studentId = activity.user ? (activity.user._id.toString() || '') : '';
            const searchData = `${studentName} ${studentEmail} ${studentPhone} ${studentId} ${activity.action} ${activity.details}`.toLowerCase();
          %>
            <li 
              class="activity-item py-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between transition-all duration-200"
              data-search="<%= searchData %>"
            >
              <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-pastel-blue border-2 border-slate-900 px-3 py-0.5 text-xs font-black text-slate-800 w-fit">
                  👤 <%= studentName %>
                  <% if (studentPhone || studentEmail) { %>
                    <span class="text-slate-500 font-normal">
                      (<%= studentPhone || studentEmail %>)
                    </span>
                  <% } %>
                </span>
                <div>
                  <strong class="text-slate-900 font-black"><%= activity.action %></strong>
                  <% if (activity.details) { %>
                    <span class="text-slate-600 font-medium"> — <%= activity.details %></span>
                  <% } %>
                </div>
              </div>

              <span class="text-xs sm:text-sm text-slate-400 font-bold shrink-0">
                🕒 <%= new Date(activity.createdAt).toLocaleString('hi-IN') %>
              </span>
            </li>
          <% }) %>
        </ul>

        <div id="no-search-results" class="hidden text-center py-12">
          <span class="text-4xl select-none inline-block">🔍</span>
          <h3 class="text-lg font-bold text-slate-700 mt-3">कोई गतिविधि नहीं मिली</h3>
          <p class="text-slate-500 text-sm font-semibold mt-1">कुछ और खोज कर देखें</p>
        </div>
      <% } %>

    </section>
  </main>

  <!-- Live Filtering JS -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('activity-search-input');
      const items = document.querySelectorAll('.activity-item');
      const noResultsMsg = document.getElementById('no-search-results');

      if (searchInput) {
        let debounceTimer;

        searchInput.addEventListener('input', (e) => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            const query = e.target.value.trim().toLowerCase();
            let matches = 0;

            items.forEach((item) => {
              const searchText = item.getAttribute('data-search') || '';
              if (!query || searchText.includes(query)) {
                item.classList.remove('hidden');
                matches++;
              } else {
                item.classList.add('hidden');
              }
            });

            if (noResultsMsg) {
              if (matches === 0 && items.length > 0 && query !== '') {
                noResultsMsg.classList.remove('hidden');
              } else {
                noResultsMsg.classList.add('hidden');
              }
            }
          }, 200);
        });
      }
    });
  </script>
</body>
</html>
